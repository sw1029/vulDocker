  "CWE-89": {
    "family": "sql_injection",
    "support_level": "builtin_supported",
    "display_name": "SQL Injection",
    "pattern_id": "sqli-string-concat",
    "fragment_strategy": "sqli_string_concat",
    "strategy_variants": [
      {
        "fragment_strategy": "sqli_string_concat_mysql",
        "runtime_db": [
          "mysql",
          "mariadb"
        ],
        "require_allow_external_db": true,
        "pattern_aliases": [
          "sqli-union-mysql",
