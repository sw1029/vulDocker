# Asset-backed family-aware fallback template for Path Traversal.
import os
from pathlib import Path
from flask import Flask, request

app = Flask(__name__)
BASE_DIR = Path('/tmp/path-demo')
BASE_DIR.mkdir(parents=True, exist_ok=True)
(BASE_DIR / 'note.txt').write_text('safe-note', encoding='utf-8')


@app.get('/health')
def health():
    return {'ok': True}


@app.get('/download')
def download():
    path = request.args.get('path', 'note.txt')
    target = os.path.join(str(BASE_DIR), path)
    with open(target, 'r', encoding='utf-8', errors='ignore') as handle:
        return handle.read()


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=__PORT__)
