      "def greet(name: str = Query('Guest')):",
      "    # Registry-backed compiler fragment: user input is concatenated into template source.",
      "    template = Template('<h1>Hello ' + name + '</h1>')",
      "    return HTMLResponse(template.render())"
    ],
