  "ssrf_loopback_fetch": {
    "import_block": [
      "import requests",
      "from fastapi import FastAPI, Query",
      "from fastapi.responses import Response"
    ],
    "route_block": [
      "@app.get('/metadata')",
      "def metadata():",
      "    return {'flag': 'FLAG{SSRF_OK}', 'service': 'metadata'}",
      "",
      "@app.get('/fetch')",
      "def fetch(url: str = Query('http://127.0.0.1:{{port}}/metadata')):",
      "    # Registry-backed compiler fragment: user-controlled URL reaches requests.get.",
      "    resp = requests.get(url, timeout=2)",
      "    return Response(",
      "        content=resp.text,",
      "        status_code=resp.status_code,",
      "        media_type=resp.headers.get('Content-Type', 'text/plain'),",
      "    )"
    ],
